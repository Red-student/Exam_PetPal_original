<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Название события">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/eventTitleInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Дата (дд.мм.гггг)">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/eventDateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Описание (необязательно)">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/eventDescInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.material.textfield.TextInputLayout>

    <CheckBox
        android:id="@+id/repeatWeeklyCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Повторять еженедельно"
        style="@style/Widget.MaterialComponents.CompoundButton.CheckBox"/>

    <CheckBox
        android:id="@+id/repeatMonthlyCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Повторять ежемесячно"
        style="@style/Widget.MaterialComponents.CompoundButton.CheckBox"/>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:hint="Время напоминания">

        <AutoCompleteTextView
            android:id="@+id/reminderTimeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"/>

    </com.google.android.material.textfield.TextInputLayout>

    <Switch
        android:id="@+id/enableNotificationSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Включить напоминание"
        android:checked="true"
        android:layout_marginTop="8dp"
        style="@style/Widget.MaterialComponents.CompoundButton.Switch"/>

</LinearLayout> 